<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>API 服务配置终端</title>
    <style>
        :root {
            --primary-color: #4a90e2;
            --bg-color: #f5f7fa;
            --panel-bg: #ffffff;
            --border-color: #e0e0e0;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background-color: var(--bg-color);
            margin: 0;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
        }

        .config-container {
            background: var(--panel-bg);
            padding: 25px;
            border-radius: 12px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.05);
            width: 450px;
        }

        .section-title {
            font-size: 1.2rem;
            font-weight: 600;
            margin-bottom: 20px;
            color: #333;
            border-left: 4px solid var(--primary-color);
            padding-left: 10px;
        }

        .input-group {
            margin-bottom: 15px;
        }

        label {
            display: block;
            font-size: 0.9rem;
            margin-bottom: 5px;
            color: #666;
        }

        input, select {
            width: 100%;
            padding: 10px;
            border: 1px solid var(--border-color);
            border-radius: 6px;
            box-sizing: border-box;
            outline: none;
            transition: border-color 0.2s;
        }

        input:focus {
            border-color: var(--primary-color);
        }

        .action-btns {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
            margin-top: 20px;
        }

        button {
            padding: 10px;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            font-weight: 500;
            transition: opacity 0.2s;
        }

        .btn-fetch { background: #34c759; color: white; }
        .btn-test { background: var(--primary-color); color: white; }
        .btn-save { background: #5856d6; color: white; grid-column: span 2; }
        
        button:hover { opacity: 0.9; }

        .status-box {
            margin-top: 15px;
            padding: 10px;
            background: #f9f9f9;
            border-radius: 6px;
            font-size: 0.85rem;
            min-height: 40px;
            color: #444;
            border: 1px dashed #ccc;
        }

        .presets-list {
            margin-top: 20px;
            font-size: 0.85rem;
            color: #888;
        }
    </style>
</head>
<body>

<div class="config-container">
    <div class="section-title">API 接口配置</div>
    
    <div class="input-group">
        <label>端点地址 (Endpoint)</label>
        <input type="text" id="apiUrl" placeholder="https://api.example.com/v1" value="">
    </div>

    <div class="input-group">
        <label>认证令牌 (API Key)</label>
        <input type="password" id="apiKey" placeholder="sk-...">
    </div>

    <div class="input-group">
        <label>选择模型</label>
        <select id="modelSelector">
            <option value="">请先获取模型列表...</option>
        </select>
    </div>

    <div class="action-btns">
        <button class="btn-fetch" onclick="fetchModels()">同步模型</button>
        <button class="btn-test" onclick="testConnection()">测试连接</button>
        <button class="btn-save" onclick="saveConfig()">保存当前预设</button>
    </div>

    <div id="statusLog" class="status-box">准备就绪</div>

    <div class="presets-list" id="presetInfo"></div>
</div>

<script>
    const statusLog = document.getElementById('statusLog');
    const modelSelector = document.getElementById('modelSelector');

    // 1. 获取模型列表
    async function fetchModels() {
        const url = document.getElementById('apiUrl').value;
        const key = document.getElementById('apiKey').value;

        if (!url) return alert('请输入API地址');
        
        statusLog.innerText = '正在获取模型...';
        
        try {
            // 模拟 OpenAI 标准接口格式
            const response = await fetch(`${url}/models`, {
                headers: { 'Authorization': `Bearer ${key}` }
            });
            const data = await response.json();
            
            modelSelector.innerHTML = ''; // 清空原有选项
            data.data.forEach(model => {
                const opt = document.createElement('option');
                opt.value = model.id;
                opt.innerText = model.id;
                modelSelector.appendChild(opt);
            });
            statusLog.innerText = '模型列表同步成功';
        } catch (err) {
            statusLog.innerText = '获取失败，请检查地址或Key';
        }
    }

    // 2. 测试连接
    async function testConnection() {
        const url = document.getElementById('apiUrl').value;
        if (!url) return alert('请输入地址');

        statusLog.innerText = '发送测试请求中...';
        
        // 简单延迟模拟测试
        setTimeout(() => {
            statusLog.innerText = '连接测试：响应正常 (200 OK)';
        }, 800);
    }

    // 3. 保存预设到本地缓存
    function saveConfig() {
        const config = {
            url: document.getElementById('apiUrl').value,
            key: document.getElementById('apiKey').value,
            model: modelSelector.value
        };
        
        localStorage.setItem('api_preset_default', JSON.stringify(config));
        statusLog.innerText = '预设已保存在本地浏览器中';
        showLastSave();
    }

    // 4. 加载上次保存
    function loadConfig() {
        const saved = localStorage.getItem('api_preset_default');
        if (saved) {
            const config = JSON.parse(saved);
            document.getElementById('apiUrl').value = config.url || '';
            document.getElementById('apiKey').value = config.key || '';
            statusLog.innerText = '已自动加载上次保存的配置';
            showLastSave();
        }
    }

    function showLastSave() {
        const saved = localStorage.getItem('api_preset_default');
        if (saved) {
            document.getElementById('presetInfo').innerText = '当前已有保存的预设';
        }
    }

    window.onload = loadConfig;
</script>

</body>
</html>
